PORT=3000
NODE_ENV=development
LOG_LEVEL=info
AUDIT_SECRET=your_super_secret_audit_hmac_key
VENDOR_JWT_SECRET=your_super_secret_vendor_jwt_key
# Passwords for the built-in partner001 / employee001 accounts. If unset, those accounts are not created.
DEFAULT_VENDOR_PASSWORD=change_me_before_deploying
DEFAULT_EMPLOYEE_PASSWORD=change_me_before_deploying
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Team email -> role map as one line of JSON (keeps emails out of the public repo).
# Alternatively leave this unset and create a git-ignored roles.json (see roles.example.json).
# Roles: OWN (owner), FIN (finance), VRF (verifier), ADM (admin), DEV (developer)
EMAIL_ROLE_MAP={"owner@example.com":{"role":"OWN","name":"Owner Name"}}

# Set to true ONLY for local demos: lets one account approve its own requests.
ALLOW_SELF_APPROVAL=false

# Gemini AI API Key for High-Class Invoice OCR (Get one free at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
